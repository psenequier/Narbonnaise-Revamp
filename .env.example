APP_NAME="Appartement Chamrousse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chamrousse
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# En local, les e-mails sont écrits dans storage/logs (aucun envoi réel) ;
# avec « docker compose up », ils vont dans Mailpit (http://localhost:8025).
MAIL_MAILER=log
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="reservation@example.test"
MAIL_FROM_NAME="${APP_NAME}"
# Garde-fou pour tester avec une copie de la vraie base : si renseigné, TOUS les e-mails
# partent vers cette seule adresse (ni copie ni copie cachée). Vide en service normal.
MAIL_REDIRIGER_VERS=

HASH_DRIVER=argon2id

# Clé du portail des API de Météo-France (bulletin d'avalanche, US-708). Vide : encart « Pas de bulletin ».
METEOFRANCE_CLE=

# Connexion Google : identifiants créés dans Google Cloud Console (gratuit).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/retour"

# Noms réels des lignées, en production seulement (dépôt public) :
# LIGNEES="Nom1:#2F6FB0,Nom2:#B5651D,Nom3:#6B4FA0"
LIGNEES=
# Autres mots des libellés GRR qui désignent une lignée (reprise) : « Surnom:Nom1,Autre:Nom2 »
LIGNEES_ALIAS=

# Reprise de GRR : préfixe des tables de l'ancien site dans la même base
GRR_PREFIXE=grr_
# Par login GRR, appliqué à chaque import : « login:admin,login:membre,login:desactive »
GRR_AJUSTEMENTS=
# ouverte avant la bascule, fermee ensuite
GRR_REPRISE=ouverte
# Annonce de la bascule : date de la mise à jour majeure de GRR (« 2019 », « mars 2019 ») ; vide = sans date
GRR_MISE_A_JOUR_MAJEURE=

# Sauvegardes chiffrées (ADR 015)
BACKUP_ARCHIVE_PASSWORD=
