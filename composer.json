{
    "name": "chamrousse/reservation",
    "description": "Réservation de l'appartement familial de Chamrousse (Le Recoin)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.38",
        "laravel/fortify": "^1.41",
        "laravel/socialite": "^5.31",
        "livewire/livewire": "^4.4",
        "spatie/laravel-backup": "^10.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.13",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "psalm/plugin-laravel": "^3.15",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --exclude-group=browser",
        "test:browser": "pest --group=browser",
        "analyse": [
            "phpstan analyse",
            "psalm --taint-analysis"
        ],
        "criteres": "php scripts/verifier-criteres.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "abandoned": "fail"
        },
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
